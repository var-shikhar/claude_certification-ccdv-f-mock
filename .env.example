# quizzMonkey configuration. Copy to .env and fill in what you need.

# ---- Database (required) ---------------------------------------------------
# Neon pooled connection string. Leave unset (or use "pglite:.data/pglite")
# to run on an embedded local Postgres with zero setup.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Auth (required) -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Accounts created with these emails become admins (comma-separated).
ADMIN_EMAILS=""

# ---- Public address (optional) -----------------------------------------------
# The site's public URL, used for canonical links, the sitemap, robots.txt,
# llms.txt, structured data and certificate verify links. Defaults to
# https://quizzmonkey.vercel.app; set it when the site moves to its own domain.
# (BETTER_AUTH_URL above is the address the app runs on, used for sign-in.)
SITE_URL=""

# Optional social sign-in; the buttons appear only when both values are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- AI features (optional) --------------------------------------------------
# Mock interviews, the tutor and the question generator use any
# OpenAI-compatible API. For LiteLLM, point OPENAI_BASE_URL at your proxy's
# /v1 URL and set AI_MODEL to one of its model aliases.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
AI_MODEL="gpt-4.1-mini"
# AI requests per learner per day (authors and admins are unlimited).
AI_DAILY_LIMIT="60"
# Free-plan AI requests per day; only applies once billing is switched on.
AI_DAILY_LIMIT_FREE="10"

# ---- Payments (optional) -----------------------------------------------------
# Leave empty and everything stays free and unlimited (Pro shows "coming soon").
# STRIPE_PRICE_ID is the recurring price for Pro. Point a Stripe webhook at
# /api/billing/webhook for checkout.session.completed and customer.subscription.*
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
# Full mocks per exam every 30 days on the free plan (billing on only).
FREE_FULL_MOCKS_PER_MONTH="2"
